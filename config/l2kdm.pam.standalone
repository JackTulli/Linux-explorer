#%PAM-1.0
# l2kdm -- the Windows 2000 logon screen, where the distribution has no
# stack of its own to include (no common-auth, base-auth or system-login).
# Everything here comes with Linux-PAM itself, so this always resolves.
auth      requisite  pam_nologin.so
auth      required   pam_unix.so
account   required   pam_unix.so
password  required   pam_unix.so
session   required   pam_unix.so
