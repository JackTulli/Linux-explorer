#!/bin/sh
# l2k-session -- start the Windows 2000 desktop as an X session.
#
# Use from ~/.xinitrc ("exec l2k-session"), from a display manager session
# entry, or inside a nested server:  Xephyr :2 -screen 1024x768 & DISPLAY=:2 l2k-session
#
# The window manager owns the desktop, taskbar and Start menu; everything
# else is an ordinary X client. Anything listed in ~/.w2k/autostart (one
# command per line) is launched once the desktop is up.
#
# When the WM dies, X dies with it and the console scrollback is gone, so
# everything is logged to ~/.w2k/session.log and anything fatal is also put
# on screen with xmessage -- which holds the X session open until dismissed.

here=$(dirname "$(readlink -f "$0")")
# Run-in-place: binaries live in ./bin. Installed: they sit beside this script.
for d in "$here/bin" "$here"; do
    [ -d "$d" ] || continue
    case ":$PATH:" in *":$d:"*) ;; *) PATH="$d:$PATH" ;; esac
done
export PATH

LOG="${HOME:-/tmp}/.w2k/session.log"
mkdir -p "${HOME:-/tmp}/.w2k" 2>/dev/null
exec >>"$LOG" 2>&1
echo "=== $(date) : l2k-session starting ==="
echo "    script : $0 -> $here"
echo "    DISPLAY: ${DISPLAY:-(unset)}   HOME: ${HOME:-(unset)}"
echo "    PATH   : $PATH"
echo "    l2kwm  : $(command -v l2kwm || echo '(not found)')"

# Show a fatal error on screen. xmessage blocks, so X stays up to be read.
die() {
    echo "l2k-session: $1"
    xmessage -center "l2k-session: $1

Details: $LOG" 2>/dev/null
    exit 1
}

command -v l2kwm >/dev/null 2>&1 \
    || die "l2kwm not found. Run 'make' in $here first."

# ------------------------------------------------------------------
# Make everything else on the desktop match
# ------------------------------------------------------------------
# Cursors: applications ask libXcursor for a *theme*, not for the .cur
# files the toolkit loads, so without this the pointer changes shape and
# size the moment it crosses into GTK, Qt or Firefox. The size is pinned:
# Xcursor would otherwise derive one from the screen's DPI, which on a 4K
# panel means a giant pointer. Rebuild the theme with
# tools/gencursortheme.py after changing the cursor set.
export XCURSOR_THEME=Windows2000
export XCURSOR_SIZE=32
# Rebuild the theme when the cursor set has changed since it was made, so
# applications show the same pointers the shell does.
if [ -d "$HOME/.w2k/cursors" ] && [ -f "$here/tools/gencursortheme.py" ]; then
    _set=$(ls -t "$HOME/.w2k/cursors" 2>/dev/null | head -1)
    if [ -n "$_set" ] && [ "$HOME/.w2k/cursors/$_set" -nt "$HOME/.icons/Windows2000/cursors/left_ptr" ]; then
        python3 "$here/tools/gencursortheme.py" "$HOME/.w2k/cursors" "$HOME/.icons/Windows2000" 2>/dev/null
    fi
fi
xrdb -merge 2>/dev/null <<'XRDB'
Xcursor.theme: Windows2000
Xcursor.size: 32
XRDB

# Widget themes: whatever Display Properties chose with the look (GtkTheme=
# and QtStyle= in ~/.w2k/scheme) -- Chicago95 for GTK and Qt's own built-in
# classic style, the Windows 9x look that needs nothing installed, unless a
# look brought B00merang's XP, Vista or 7 themes or the Windows 7 Kvantum
# theme with it. ~/.config/qt5ct also carries the desktop's palette, used
# when QT_QPA_PLATFORMTHEME is set to qt5ct or qt6ct.
GTK_THEME=$(sed -n 's/^GtkTheme=//p' "$HOME/.w2k/scheme" 2>/dev/null | head -n 1)
QT_STYLE_OVERRIDE=$(sed -n 's/^QtStyle=//p' "$HOME/.w2k/scheme" 2>/dev/null | head -n 1)
export QT_STYLE_OVERRIDE="${QT_STYLE_OVERRIDE:-Windows}"
export GTK_THEME="${GTK_THEME:-Chicago95}"
# qt5ct/qt6ct carry the Windows 2000 palette install.sh wrote; without them
# Qt still gets the Windows style from QT_STYLE_OVERRIDE.
if command -v qt6ct >/dev/null 2>&1; then export QT_QPA_PLATFORMTHEME=qt6ct
elif command -v qt5ct >/dev/null 2>&1; then export QT_QPA_PLATFORMTHEME=qt5ct
fi

# ------------------------------------------------------------------
# The nested compositor (experimental)
# ------------------------------------------------------------------
# Compositor=nested in the scheme: the desktop runs inside Xvfb at each
# monitor's logical size, and l2kscaler shows that screen on the real one
# through its GPU scaler (docs/SCALING.md). Only when some monitor is
# scaled, and only with both programs present; otherwise the session runs
# plainly and says why in the log.
NESTED_PID= SCALER_PID=
if [ "$(sed -n 's/^Compositor=//p' "$HOME/.w2k/scheme" 2>/dev/null | head -n 1)" = nested ]; then
    # From the Monitor= lines (name mode x y primary enabled rate scale):
    # each monitor's window on the real screen, its logical rectangle in
    # the nested one, the nested screen's size, and the plain xrandr layout.
    plan=$(awk -F'[ =]' '/^Monitor=/ {
        name=$2; mode=$3; split(mode, wh, "x"); W=wh[1]+0; H=wh[2]+0; x=$4+0; y=$5+0; pri=$6+0; en=$7+0; sc=$9+0
        if (sc <= 0) sc = 100; if (en != 1 || W <= 0 || H <= 0) next
        lw = int(W * 100 / sc + 0.5); lh = int(H * 100 / sc + 0.5)
        layout = layout name "," W "," H "," x "," y "," lw "," lh "," x "," y ";"
        mon = mon name ":" lw "x" lh "+" x "+" y ":" pri ";"
        if (x + lw > nw) nw = x + lw; if (y + lh > nh) nh = y + lh
        xr = xr " --output " name " --mode " mode " --pos " x "x" y " --scale 1x1 --filter bilinear" (pri == 1 ? " --primary" : "")
        if (sc > 100) any = 1
    } END { print layout; print mon; print nw + 0; print nh + 0; print xr; print any + 0 }' "$HOME/.w2k/scheme")
    n_layout=$(printf '%s\n' "$plan" | sed -n 1p)
    n_mon=$(printf '%s\n' "$plan" | sed -n 2p)
    n_w=$(printf '%s\n' "$plan" | sed -n 3p)
    n_h=$(printf '%s\n' "$plan" | sed -n 4p)
    n_xr=$(printf '%s\n' "$plan" | sed -n 5p)
    n_any=$(printf '%s\n' "$plan" | sed -n 6p)
    if [ "$n_any" != 1 ] || [ -z "$n_layout" ]; then
        echo "l2k-session: nested compositor: no scaled monitor in the scheme; running plainly"
    elif ! { command -v Xephyr >/dev/null 2>&1 || command -v Xvfb >/dev/null 2>&1; } || \
         ! command -v l2kscaler >/dev/null 2>&1; then
        echo "l2k-session: nested compositor: needs Xephyr (or Xvfb) and l2kscaler; running plainly"
    else
        host_display=$DISPLAY
        # The real screen: every monitor at its own size, nothing scaled.
        # shellcheck disable=SC2086
        xrandr $n_xr >/dev/null 2>&1 || echo "l2k-session: xrandr refused the plain layout; carrying on"
        n=1; while [ -e "/tmp/.X11-unix/X$n" ] && [ "$n" -lt 20 ]; do n=$((n + 1)); done
        nauth=
        if command -v xauth >/dev/null 2>&1 && command -v mcookie >/dev/null 2>&1; then
            xauth add ":$n" . "$(mcookie)" 2>/dev/null && nauth="-auth ${XAUTHORITY:-$HOME/.Xauthority}"
        fi
        # Xephyr draws its own screen with the GPU (glamor); Xvfb is the
        # fallback, in software. Either way the programs inside render in
        # software: Xephyr offers them neither DRI2 nor DRI3, so their GL is
        # llvmpipe -- the price of the nested compositor.
        #
        # The scaler reads the nested screen through shared memory, so
        # Xephyr's own window on this screen, which the scaler covers, need
        # not be drawn at all: -glamor-skip-present saves that copy on every
        # change. Not when the scaler takes that very window's pixmap
        # (CompositorCapture=pixmap), nor from an Xephyr that lacks it.
        nested_kind=
        if command -v Xephyr >/dev/null 2>&1; then
            skip_present=
            [ "$(sed -n 's/^CompositorCapture=//p' "$HOME/.w2k/scheme" 2>/dev/null | head -n 1)" = pixmap ] || \
                ! Xephyr -help 2>&1 | grep -q -- -glamor-skip-present || skip_present=-glamor-skip-present
            # shellcheck disable=SC2086
            Xephyr ":$n" -glamor $skip_present -screen "${n_w}x${n_h}x24" -title l2k-nested -no-host-grab \
                -nolisten tcp -noreset -dpi 96 $nauth >>"$LOG" 2>&1 &
            NESTED_PID=$!
            i=0; while [ ! -e "/tmp/.X11-unix/X$n" ] && kill -0 "$NESTED_PID" 2>/dev/null && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
            if [ -e "/tmp/.X11-unix/X$n" ]; then nested_kind=xephyr
            else echo "l2k-session: Xephyr with glamor did not come up; trying Xvfb"; kill "$NESTED_PID" 2>/dev/null; NESTED_PID=
            fi
        fi
        if [ -z "$nested_kind" ] && command -v Xvfb >/dev/null 2>&1; then
            # shellcheck disable=SC2086
            Xvfb ":$n" -screen 0 "${n_w}x${n_h}x24" -nolisten tcp -noreset -dpi 96 $nauth >>"$LOG" 2>&1 &
            NESTED_PID=$!
            i=0; while [ ! -e "/tmp/.X11-unix/X$n" ] && [ "$i" -lt 50 ]; do sleep 0.1; i=$((i + 1)); done
            [ -e "/tmp/.X11-unix/X$n" ] && nested_kind=xvfb
        fi
        if [ -z "$nested_kind" ]; then
            echo "l2k-session: no nested server came up; running plainly"
            [ -n "$NESTED_PID" ] && kill "$NESTED_PID" 2>/dev/null; NESTED_PID=
        else
            echo "    nested : :$n ($nested_kind) at ${n_w}x${n_h}; layout $n_layout"
            # The same keyboard in both servers, so keycodes sent through mean the same.
            xkbcomp "$host_display" - 2>/dev/null | xkbcomp - ":$n" >/dev/null 2>&1
            # Tell the nested server's RandR about the monitors too, for programs that ask.
            printf '%s\n' "$n_mon" | tr ';' '\n' | while IFS=: read -r mname mgeo mpri; do
                [ -n "$mname" ] || continue
                mw=${mgeo%%x*}; rest=${mgeo#*x}; mh=${rest%%+*}; rest=${rest#*+}; mx=${rest%%+*}; my=${rest#*+}
                xrandr --display ":$n" --setmonitor "$mname" "${mw}/0x${mh}/0+${mx}+${my}" none >/dev/null 2>&1
            done
            # The screen is read through shared memory unless the scheme asks
            # for the GPU's own copy (CompositorCapture=pixmap): binding the
            # nested window's pixmap straight into the scaler's texture,
            # which some drivers take badly.
            scaler_args=
            [ "$nested_kind" = xephyr ] && \
                [ "$(sed -n 's/^CompositorCapture=//p' "$HOME/.w2k/scheme" 2>/dev/null | head -n 1)" = pixmap ] && \
                scaler_args="--nested-window l2k-nested"
            c_filter=$(sed -n 's/^CompositorFilter=//p' "$HOME/.w2k/scheme" 2>/dev/null | head -n 1)
            c_light=$(sed -n 's/^CompositorLight=//p' "$HOME/.w2k/scheme" 2>/dev/null | head -n 1)
            c_ar=$(sed -n 's/^CompositorAntiring=//p' "$HOME/.w2k/scheme" 2>/dev/null | head -n 1)
            [ -n "$c_filter" ] && scaler_args="$scaler_args --filter $c_filter"
            [ "$c_light" = linear ] && scaler_args="$scaler_args --linear-light"
            [ "$c_ar" = 0 ] && scaler_args="$scaler_args --antiring 0"
            # shellcheck disable=SC2086
            DISPLAY=$host_display l2kscaler --nested ":$n" --layout "$n_layout" $scaler_args >>"$LOG" 2>&1 &
            SCALER_PID=$!
            export DISPLAY=":$n" W2K_MONITORS="$n_mon" W2K_UI_SCALE=100
        fi
    fi
fi

# ------------------------------------------------------------------
# The composited scaler (experimental)
# ------------------------------------------------------------------
# Compositor=composite: no second server. l2kscaler composites this one,
# as picom does -- every window drawn off screen, put together on the GPU
# and scaled -- so the programs keep the GPU. The monitors run at their
# own modes; the desktop lives at their logical sizes in the screen's
# top-left, which programs are told through RandR monitors of that size
# and the desktop through W2K_MONITORS and W2K_SCREEN. l2kscaler scales
# the pointer to match. If it will not start, the session runs plainly.
COMP_MONS=
if [ -z "$SCALER_PID" ] && \
   [ "$(sed -n 's/^Compositor=//p' "$HOME/.w2k/scheme" 2>/dev/null | head -n 1)" = composite ]; then
    # From the Monitor= lines: each monitor's real rectangle and its
    # logical one (the real position over the scale), the desktop's size,
    # and the plain xrandr layout.
    plan=$(awk -F'[ =]' '/^Monitor=/ {
        name=$2; mode=$3; split(mode, wh, "x"); W=wh[1]+0; H=wh[2]+0; x=$4+0; y=$5+0; pri=$6+0; en=$7+0; sc=$9+0
        if (sc <= 0) sc = 100; if (en != 1 || W <= 0 || H <= 0) next
        lw = int(W * 100 / sc + 0.5); lh = int(H * 100 / sc + 0.5)
        lx = int(x * 100 / sc + 0.5); ly = int(y * 100 / sc + 0.5)
        layout = layout name "," W "," H "," x "," y "," lw "," lh "," lx "," ly ";"
        mon = mon name ":" lw "x" lh "+" lx "+" ly ":" pri ";"
        rr = rr name ":" lw "x" lh "+" lx "+" ly ";"
        if (lx + lw > sw) sw = lx + lw; if (ly + lh > sh) sh = ly + lh
        xr = xr " --output " name " --mode " mode " --pos " x "x" y " --scale 1x1 --filter bilinear" (pri == 1 ? " --primary" : "")
        if (sc > 100) any = 1; if (sc < 100) small = 1
    } END { print layout; print mon; print sw + 0; print sh + 0; print xr; print any + 0; print rr; print small + 0 }' "$HOME/.w2k/scheme")
    c_layout=$(printf '%s\n' "$plan" | sed -n 1p)
    c_mon=$(printf '%s\n' "$plan" | sed -n 2p)
    c_w=$(printf '%s\n' "$plan" | sed -n 3p)
    c_h=$(printf '%s\n' "$plan" | sed -n 4p)
    c_xr=$(printf '%s\n' "$plan" | sed -n 5p)
    c_any=$(printf '%s\n' "$plan" | sed -n 6p)
    c_rr=$(printf '%s\n' "$plan" | sed -n 7p)
    c_small=$(printf '%s\n' "$plan" | sed -n 8p)
    if [ "$c_any" != 1 ] || [ -z "$c_layout" ]; then
        echo "l2k-session: composited scaler: no scaled monitor in the scheme; running plainly"
    elif [ "$c_small" = 1 ]; then
        echo "l2k-session: composited scaler: a scale under 100% cannot be composited; running plainly"
    elif ! command -v l2kscaler >/dev/null 2>&1; then
        echo "l2k-session: composited scaler: l2kscaler is not installed; running plainly"
    else
        # shellcheck disable=SC2086
        xrandr $c_xr >/dev/null 2>&1 || echo "l2k-session: xrandr refused the plain layout; carrying on"
        scaler_args=
        c_filter=$(sed -n 's/^CompositorFilter=//p' "$HOME/.w2k/scheme" 2>/dev/null | head -n 1)
        c_light=$(sed -n 's/^CompositorLight=//p' "$HOME/.w2k/scheme" 2>/dev/null | head -n 1)
        c_ar=$(sed -n 's/^CompositorAntiring=//p' "$HOME/.w2k/scheme" 2>/dev/null | head -n 1)
        [ -n "$c_filter" ] && scaler_args="$scaler_args --filter $c_filter"
        [ "$c_light" = linear ] && scaler_args="$scaler_args --linear-light"
        [ "$c_ar" = 0 ] && scaler_args="$scaler_args --antiring 0"
        # shellcheck disable=SC2086
        l2kscaler --composite --layout "$c_layout" $scaler_args >>"$LOG" 2>&1 &
        SCALER_PID=$!
        sleep 1
        if ! kill -0 "$SCALER_PID" 2>/dev/null; then
            echo "l2k-session: composited scaler: l2kscaler did not start (see above); running plainly"
            SCALER_PID=
        else
            # Programs ask RandR where the monitors are: each output gets a
            # monitor of its logical size, which stands in for its own.
            printf '%s\n' "$c_rr" | tr ';' '\n' | while IFS=: read -r mname mgeo; do
                [ -n "$mname" ] || continue
                mw=${mgeo%%x*}; rest=${mgeo#*x}; mh=${rest%%+*}; rest=${rest#*+}; mx=${rest%%+*}; my=${rest#*+}
                xrandr --setmonitor "l2k-$mname" "${mw}/0x${mh}/0+${mx}+${my}" "$mname" >/dev/null 2>&1
            done
            COMP_MONS=$c_rr
            echo "    composited: layout $c_layout; the desktop at ${c_w}x${c_h}"
            export W2K_MONITORS="$c_mon" W2K_SCREEN="${c_w}x${c_h}" W2K_UI_SCALE=100
        fi
    fi
fi

# Which desktop this is: l2kdm says so, startx does not. xdg-desktop-portal
# picks its back ends by it (w2k-portals.conf).
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-W2K}"
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-x11}"

# Hand the lot to D-Bus, or anything it launches starts with none of it.
dbus-update-activation-environment --systemd \
    DISPLAY XAUTHORITY XCURSOR_THEME XCURSOR_SIZE QT_STYLE_OVERRIDE \
    QT_QPA_PLATFORMTHEME GTK_THEME XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null

# graphical-session.target, through l2k-session.target: xdg-desktop-portal
# will not start without it, and with no portal a Flatpak program's Open
# and Save As do nothing. A portal that already refused is let try again.
if command -v systemctl >/dev/null 2>&1 && \
   systemctl --user cat l2k-session.target >/dev/null 2>&1; then
    systemctl --user reset-failed xdg-desktop-portal.service 2>/dev/null
    systemctl --user start l2k-session.target 2>/dev/null \
        || echo "l2k-session: could not start l2k-session.target; portals stay off"
fi

# A PolicyKit authentication agent, so that pkexec can ask for a password:
# the lid and power-button settings, Device Manager's drivers, Disk
# Management and the brightness fallback all go through it. Whichever of
# the usual agents is installed; none is fatal, only those things fail.
if ! pgrep -f 'polkit.*agent' >/dev/null 2>&1 && ! pgrep -x lxpolkit >/dev/null 2>&1; then
    for agent in lxpolkit \
        /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1 \
        /usr/libexec/polkit-gnome-authentication-agent-1 \
        /usr/lib/x86_64-linux-gnu/polkit-gnome/polkit-gnome-authentication-agent-1 \
        /usr/lib/polkit-gnome-authentication-agent-1 \
        /usr/libexec/polkit-mate-authentication-agent-1 \
        /usr/lib/x86_64-linux-gnu/polkit-mate/polkit-mate-authentication-agent-1 \
        /usr/lib/xfce-polkit/xfce-polkit /usr/libexec/xfce-polkit/xfce-polkit \
        lxqt-policykit-agent \
        /usr/lib/x86_64-linux-gnu/libexec/polkit-kde-authentication-agent-1 \
        /usr/libexec/polkit-kde-authentication-agent-1 \
        /usr/lib/polkit-kde-authentication-agent-1 \
        hyprpolkitagent; do
        case $agent in
            /*) [ -x "$agent" ] || continue ;;
            *)  command -v "$agent" >/dev/null 2>&1 || continue ;;
        esac
        "$agent" >/dev/null 2>&1 &
        break
    done
fi

# Bluetooth: the agent that answers devices pairing with this computer
# while Bluetooth Devices is closed, and the icon in the notification
# area. It keeps to itself until bluetoothd and a radio are there.
if command -v l2kbluetooth >/dev/null 2>&1; then
    l2kbluetooth --agent >>"$LOG" 2>&1 &
fi

# Windows programs: Wine's prefix is made the first time it is missing,
# in the background -- it takes a while -- so an .exe opened from
# Explorer finds one ready. Wine's own menu builder then keeps the Start
# menu's Windows Programs group and the file associations up to date.
if command -v wine >/dev/null 2>&1 && [ ! -d "${WINEPREFIX:-$HOME/.wine}" ]; then
    echo "l2k-session: making Wine's prefix at ${WINEPREFIX:-$HOME/.wine}"
    (WINEDEBUG=-all wineboot -u >>"$LOG" 2>&1 &)
fi

xsetroot -solid "#3a6ea5" 2>/dev/null
xset b off 2>/dev/null

# Each autostart line is one argument to the WM, exactly as written: no
# second parse of quotes, dollars or backticks.
set --
if [ -r "$HOME/.w2k/autostart" ]; then
    while IFS= read -r line; do
        case "$line" in ''|'#'*) continue ;; esac
        set -- "$@" "$line"
    done < "$HOME/.w2k/autostart"
fi

# The WM exits when the user logs off (0), shuts down (10) or restarts (11).
l2kwm -- "$@"
rc=$?
echo "=== $(date) : l2kwm exited with $rc ==="
# The session is over for the portals too; the next logon starts them again.
command -v systemctl >/dev/null 2>&1 && systemctl --user stop l2k-session.target 2>/dev/null
[ -n "$SCALER_PID" ] && kill "$SCALER_PID" 2>/dev/null
[ -n "$NESTED_PID" ] && kill "$NESTED_PID" 2>/dev/null
# The composited scaler puts the pointers back as it goes; if it died, this
# does. The logical monitors go, and the outputs' own come back.
if [ -n "$COMP_MONS" ]; then
    sleep 0.3
    l2kscaler --restore-input >/dev/null 2>&1
    printf '%s\n' "$COMP_MONS" | tr ';' '\n' | while IFS=: read -r mname mgeo; do
        [ -n "$mname" ] && xrandr --delmonitor "l2k-$mname" >/dev/null 2>&1
    done
fi
case $rc in
    0)  ;;
    10) systemctl poweroff 2>/dev/null || loginctl poweroff 2>/dev/null || poweroff ;;
    11) systemctl reboot   2>/dev/null || loginctl reboot   2>/dev/null || reboot ;;
    *)  die "l2kwm exited with status $rc (see the log for its last words)." ;;
esac
exit 0
